# Neon Postgres (provisioned via Vercel Marketplace: `vercel integration add neon`)
# Pooled connection — used by the app at runtime via @neondatabase/serverless.
DATABASE_URL=

# Non-pooled ("direct") connection to the same database — same host as
# DATABASE_URL minus the "-pooler" suffix. Used only by drizzle-kit for
# migrations: Neon's pooled/PgBouncer endpoint doesn't support the
# session-level locks drizzle-kit's migrator needs, which makes `npm run
# db:migrate` hang indefinitely against a pooled URL.
DIRECT_URL=

# Single-user auth stub (v1) — email of the one seeded user
SEED_USER_EMAIL=
